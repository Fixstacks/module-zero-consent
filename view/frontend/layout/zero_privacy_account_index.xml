<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="zero.privacy.account" cacheable="false" template="Zero_Consent::privacy.phtml">
                <arguments>
                    <argument name="config" xsi:type="object">Zero\Consent\ViewModel\Privacy</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
